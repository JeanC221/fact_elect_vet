# ==============================================================================
# fact_elect_vet — plantilla de variables de entorno
# ==============================================================================
# Copie este archivo a `.env.local` y rellene los valores reales.
# NUNCA suba `.env.local` al repositorio: contiene credenciales de producción
# con capacidad de emitir documentos legales ante la DIAN.
#
# Esta lista se generó del código, no de memoria:
#   grep -rhoE "process\.env\.[A-Z0-9_]+" src/ scripts/ | sort -u
# Si añade una variable nueva al código, añádala también aquí.
# `NODE_ENV` no aparece: lo fija Next.js y declararlo rompe `next build`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Sesión y credenciales de personal (obligatorias)
# ------------------------------------------------------------------------------
# Clave de firma HMAC-SHA256 del JWT de sesión. Mínimo 16 caracteres.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Dos juegos independientes de credenciales. Se guarda SOLO el hash SHA-256 del
# password en base64url, nunca el password en claro.
# Generar el hash:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('SU_PASSWORD')).then(d => console.log(Buffer.from(d).toString('base64url')))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# Base de datos (obligatoria)
# ------------------------------------------------------------------------------
# Cadena de conexión Postgres de Supabase (driver `pg` directo, sin PostgREST).
DATABASE_URL=

# Certificado CA de Supabase en PEM, para verificación TLS estricta.
# Opcional en desarrollo; recomendado en producción.
SUPABASE_DB_CA_CERT=

# ------------------------------------------------------------------------------
# Siigo Nube (obligatorias para emitir)
# ------------------------------------------------------------------------------
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=

# Cabecera obligatoria en toda petición saliente a Siigo. Entre 3 y 100
# caracteres alfanuméricos, sin espacios ni caracteres especiales. Siigo
# bloquea usuarios API que envíen un valor ficticio.
SIIGO_PARTNER_ID=

# Base de la API. Por defecto https://api.siigo.com si se omite.
SIIGO_API_BASE_URL=

# Base usada por el chequeo de salud/autenticación.
SIIGO_BASE_URL=

# "true" fuerza modo sandbox. OJO: el modo de emisión real vive en la tabla
# `credentials_config` y se lee por `GET /api/emission-mode`; esta variable no
# la sustituye. Emitir en sandbox implica `stamp.send: false`, es decir,
# facturas SIN timbrar ante la DIAN y sin validez legal.
SIIGO_SANDBOX_MODE=

# Espera en ms antes de reconciliar contra Siigo tras una emisión ambigua.
SIIGO_RECONCILE_DELAY_MS=

# ------------------------------------------------------------------------------
# Provet Cloud (obligatorias para leer consultas)
# ------------------------------------------------------------------------------
# URL base específica del tenant de la clínica.
PROVET_BASE_URL=
PROVET_TOKEN_URL=
PROVET_CLIENT_ID=
PROVET_CLIENT_SECRET=
PROVET_API_KEY=

# Ventana de sincronización en días para la cola de consultas.
PROVET_SYNC_WINDOW_DAYS=

# ------------------------------------------------------------------------------
# UI
# ------------------------------------------------------------------------------
# Intervalo de refresco de la cola en ms. Expuesta al navegador por el prefijo
# NEXT_PUBLIC_: no ponga aquí nada sensible.
NEXT_PUBLIC_QUEUE_POLL_MS=

# ------------------------------------------------------------------------------
# Heredada — pendiente de retirada
# ------------------------------------------------------------------------------
# Vercel Blob. El almacenamiento migró a Postgres; solo la usa
# `scripts/migrate-blob-to-postgres.ts`. Déjela vacía salvo que vaya a ejecutar
# esa migración.
BLOB_READ_WRITE_TOKEN=
