# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in the actual values.
# NEVER commit .env.local to version control — it contains production secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# AUTHENTICATION (Task 3.4)
# ----------------------------------------------------------------------------

# HMAC-SHA256 signing secret for session JWTs (min 16 chars, random string).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# Authorized employee email (case-insensitive on login).
EMPLOYEE_EMAIL="recepcion@vetclinic.com"

# sha256(password) encoded as base64url (NO plaintext password here).
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('base64url'))"
EMPLOYEE_PASSWORD_HASH="REPLACE_WITH_BASE64URL_SHA256_OF_YOUR_PASSWORD"

# Authorized administrator email (case-insensitive). Grants access to the
# Credentials & Catalog mapping pages and shows their nav links.
# Set equal to EMPLOYEE_EMAIL for a single admin operator; leave unset to
# disable admin-only routes (everyone is a regular employee).
ADMIN_EMAIL="admin@vetclinic.com"

# ----------------------------------------------------------------------------
# SIIGO NUBE INTEGRATION (Tasks 2.1, 4.2, 6.1)
# ----------------------------------------------------------------------------

# Partner ID provided by Siigo (alphanumeric, 3-100 chars).
SIIGO_PARTNER_ID="your-siigo-partner-id"

# Siigo API username (typically an email address).
SIIGO_USERNAME="api-user@yourcompany.com"

# Siigo API access key (generated in Siigo dashboard).
SIIGO_ACCESS_KEY="your-siigo-access-key"

# OAuth 2.0 Client ID for Siigo authentication (Task 6.1).
SIIGO_CLIENT_ID="your-siigo-client-id"

# OAuth 2.0 Client Secret for Siigo authentication (Task 6.1).
SIIGO_CLIENT_SECRET="your-siigo-client-secret"

# Siigo API base URL.
# Sandbox: https://api-sandbox.siigo.com
# Production: https://api.siigo.com
SIIGO_BASE_URL="https://api-sandbox.siigo.com"

# Toggle between Sandbox (true) and Production (false) mode.
# WARNING: Set to "false" ONLY when ready for live DIAN invoicing.
SIIGO_SANDBOX_MODE="true"

# ----------------------------------------------------------------------------
# PROVET CLOUD INTEGRATION (Tasks 2.1, 4.2)
# ----------------------------------------------------------------------------

# Provet Cloud API key (generated in Provet dashboard).
PROVET_API_KEY="your-provet-api-key"

# Provet Cloud clinic ID (numeric, found in Provet account settings).
PROVET_CLINIC_ID="12345"

# Provet Cloud API base URL.
# Default: https://api.provetcloud.com
PROVET_BASE_URL="https://api.provetcloud.com"

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------

# Node environment (development | production).
# Vercel sets this automatically — only needed for local testing.
NODE_ENV="development"

